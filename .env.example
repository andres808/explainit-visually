# Server-only secrets. Never prefix them with NEXT_PUBLIC_.
IDEOGRAM_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
VISION_MODEL=
# Optional alternative credential alias for OpenAI.
OPENAI_API_KEY=
MAX_SESSION_REQUESTS=20
# Monthly subscription configuration; no billing until all are configured.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_SESSION_SECRET=
BILLING_TEST_MODE=true
# Trusted Site-specific identity of the owner; required for live AI during billing tests.
LIVE_GENERATION_OWNER_ID=
APP_URL=http://localhost:5173
# For next dev only, not a deployed Worker. Hosted billing uses D1 binding DB.
BILLING_LOCAL_STORAGE=false
